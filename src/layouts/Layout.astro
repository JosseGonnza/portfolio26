---
import '../styles/global.css';
import NavDots from '../components/NavDots.astro';
import Cursor from '../components/Cursor.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Jose González | Backend Developer",
  description = "Desarrollador backend con empresa propia en producción. Java · Spring Boot · PostgreSQL · Docker. Disponible para prácticas (FCT) en octubre 2026. Fundador de JotaGe Studio.",
  ogImage = "https://dev.jotagestudio.es/og-image.webp",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Jose Manuel González Quevedo" />
    <meta name="keywords" content="backend developer, Java, Spring Boot, PostgreSQL, Docker, API REST, Astro, Tailwind, portfolio, prácticas FCT, DAW, Gijón, Asturias, JotaGe Studio" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:image:type"  content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt"   content="Jose González | Backend Developer Portfolio" />
    <meta property="og:locale"      content="es_ES" />
    <meta property="og:site_name"   content="Jose González · Dev" />

    <!-- Twitter / X -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />
    <meta name="twitter:image:alt"   content="Jose González | Backend Developer Portfolio" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#1A1A1A" />

    <!-- Umami Analytics -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id="b5afd140-1763-44f3-af1c-bdbe23a7229b"></script>
  </head>

  <body>
    <Cursor />
    <NavDots />
    <slot />

    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // Lenis + ScrollTrigger — arrancan juntos tras el preloader
      document.addEventListener('preloader-done', () => {
        const lenis = new Lenis({ lerp: 0.07, smoothWheel: true });
        (window as any).__lenis = lenis;

        // Sincronizar Lenis con ScrollTrigger
        lenis.on('scroll', () => ScrollTrigger.update());
        gsap.ticker.add((time) => lenis.raf(time * 1000));
        gsap.ticker.lagSmoothing(0);

        // Recalcular posiciones después de que todos los componentes
        // hayan montado sus ScrollTriggers y el pin de #h-scene esté activo
        setTimeout(() => ScrollTrigger.refresh(), 200);
      }, { once: true });
    </script>
  </body>
</html>
