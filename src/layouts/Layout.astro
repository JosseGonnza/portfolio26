---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Jose González — Backend Developer",
  description = "Desarrollador backend con empresa propia en producción. Java · Spring Boot · SQL · Docker. Disponible para prácticas en octubre 2026.",
  ogImage = "https://dev.jotagestudio.es/og-image.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Jose González" />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:locale"      content="es_ES" />
    <meta property="og:site_name"   content="Jose González · Dev" />

    <!-- Twitter / X -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- Favicon (placeholder — añadir cuando esté el diseño) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta name="theme-color" content="#1A1A1A" />
  </head>

  <body>
    <slot />

    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // data-reveal sencillo (elementos sin ScrollTrigger propio)
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1 }
      );
      document
        .querySelectorAll('[data-reveal], [data-reveal-stagger] > *')
        .forEach((el) => observer.observe(el));

      // Lenis + ScrollTrigger — arrancan juntos tras el preloader
      document.addEventListener('preloader-done', () => {
        const lenis = new Lenis({ lerp: 0.07, smoothWheel: true });

        // Sincronizar Lenis con ScrollTrigger
        lenis.on('scroll', () => ScrollTrigger.update());
        gsap.ticker.add((time) => lenis.raf(time * 1000));
        gsap.ticker.lagSmoothing(0);

        // Recalcular posiciones después de que todos los componentes
        // hayan montado sus ScrollTriggers y el pin de #h-scene esté activo
        setTimeout(() => ScrollTrigger.refresh(), 200);
      }, { once: true });
    </script>
  </body>
</html>
