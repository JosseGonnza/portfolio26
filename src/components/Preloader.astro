<div id="preloader" aria-hidden="true">
  <div id="preloader-text">
    <div class="preloader-line" id="line-jose">
      <span class="letter">J</span><span class="letter">O</span><span class="letter">S</span><span class="letter">E</span>
    </div>
    <div class="preloader-line" id="line-gonzalez">
      <span class="letter">G</span><span class="letter">O</span><span class="letter">N</span><span class="letter">Z</span><span class="letter">Á</span><span class="letter">L</span><span class="letter">E</span><span class="letter">Z</span>
    </div>
  </div>
  <p id="preloader-hint">· click para continuar</p>
  <div id="preloader-curtain"></div>
</div>

<style>
  #preloader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #1A1A1A;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    cursor: pointer;
  }

  #preloader-text {
    text-align: center;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6em;
  }

  .preloader-line {
    overflow: hidden;
    line-height: 1.3;
    display: flex;
    justify-content: center;
  }

  .letter {
    display: inline-block;
    font-family: 'Syncopate', sans-serif;
    font-weight: 700;
    font-size: clamp(2.5rem, 8vw, 7rem);
    color: #F3F4F6;
  }

  #preloader-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: 'Syncopate', sans-serif;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #FF5733;
    white-space: nowrap;
    z-index: 1;
    pointer-events: none;
  }

  #preloader-curtain {
    position: absolute;
    inset: 0;
    background: #FF5733;
    z-index: 2;
    pointer-events: none;
  }
</style>

<script>
  import { gsap } from 'gsap';

  // Evitar que el browser restaure scroll de visitas anteriores
  history.scrollRestoration = 'manual';
  window.scrollTo(0, 0);

  const preloader = document.getElementById('preloader') as HTMLElement;
  const textEl    = document.getElementById('preloader-text') as HTMLElement;
  const letters   = document.querySelectorAll<HTMLElement>('.letter');
  const curtain   = document.getElementById('preloader-curtain') as HTMLElement;
  const hint      = document.getElementById('preloader-hint') as HTMLElement;

  // Si ya se vio en esta sesión, saltar el preloader
  if (sessionStorage.getItem('preloader_shown')) {
    preloader.remove();
    // Doble rAF: asegura que todos los scripts han registrado sus listeners
    // antes de disparar el evento (el skip síncrono los saltaba)
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        document.dispatchEvent(new CustomEvent('preloader-done'));
      });
    });
  } else {

  document.body.style.overflow = 'hidden';

  gsap.set(letters, { yPercent: 110 });
  gsap.set(curtain, { yPercent: 100 });
  gsap.set(hint,    { opacity: 0 });

  let canClick = false;
  let hintLoop: gsap.core.Tween | null = null;

  // ── Entrada letra a letra ─────────────────────────────────────
  gsap.timeline()
    .to(letters, {
      yPercent: 0,
      duration: 0.7,
      ease: 'power3.out',
      stagger: { each: 0.045, from: 'start' },
      onComplete() {
        canClick = true;
        gsap.fromTo(hint,
          { opacity: 0 },
          {
            opacity: 1,
            duration: 0.6,
            onComplete() {
              hintLoop = gsap.to(hint, {
                opacity: 0.35,
                duration: 1.2,
                yoyo: true,
                repeat: -1,
                ease: 'sine.inOut',
              });
            },
          }
        );
        initTilt();
      },
    });

  // ── Card tilt con el mouse ────────────────────────────────────
  function initTilt() {
    document.addEventListener('mousemove', onMouseMove);
  }

  function onMouseMove(e: MouseEvent) {
    const cx = window.innerWidth  / 2;
    const cy = window.innerHeight / 2;
    const rx = ((e.clientY - cy) / cy) * -14;
    const ry = ((e.clientX - cx) / cx) *  14;
    gsap.to(textEl, {
      rotateX: rx,
      rotateY: ry,
      transformPerspective: 700,
      duration: 0.55,
      ease: 'power2.out',
    });
  }

  // ── Burbujas naranja ──────────────────────────────────────────
  function spawnBubbles(x: number, y: number) {
    const count = 6 + Math.floor(Math.random() * 5);
    for (let i = 0; i < count; i++) {
      const size = 6 + Math.random() * 18;
      const b = document.createElement('div');
      Object.assign(b.style, {
        position:      'fixed',
        width:         size + 'px',
        height:        size + 'px',
        borderRadius:  '50%',
        background:    i % 3 === 0 ? '#FF5733' : i % 3 === 1 ? '#ff7a5c' : '#cc3d1f',
        left:          x + 'px',
        top:           y + 'px',
        pointerEvents: 'none',
        zIndex:        '10000',
        opacity:       String(0.7 + Math.random() * 0.3),
      });
      document.body.appendChild(b);

      const angle = Math.random() * Math.PI * 2;
      const dist  = 60 + Math.random() * 150;
      gsap.to(b, {
        x: Math.cos(angle) * dist,
        y: Math.sin(angle) * dist - 20,
        opacity: 0,
        scale: 0.1,
        duration: 0.5 + Math.random() * 0.45,
        ease: 'power2.out',
        onComplete: () => b.remove(),
      });
    }
  }

  // ── Exit al hacer click ───────────────────────────────────────
  function exitPreloader() {
    if (!canClick) return;
    canClick = false;

    document.removeEventListener('mousemove', onMouseMove);
    hintLoop?.kill();
    gsap.to(hint, { opacity: 0, duration: 0.15 });

    // Volver a plano antes de explotar
    gsap.to(textEl, { rotateX: 0, rotateY: 0, duration: 0.2, ease: 'power2.out' });

    setTimeout(() => {
      letters.forEach((letter) => {
        const rect = letter.getBoundingClientRect();
        spawnBubbles(rect.left + rect.width / 2, rect.top + rect.height / 2);

        const dx  = (Math.random() - 0.5) * 400;
        const dy  = (Math.random() - 0.5) * 250 - 80;
        const rot = (Math.random() - 0.5) * 120;

        gsap.to(letter, {
          x: dx, y: dy,
          rotation: rot,
          opacity: 0,
          duration: 0.5,
          ease: 'power3.in',
          delay: Math.random() * 0.08,
        });
      });

      // Cortina naranja
      gsap.timeline({ delay: 0.28 })
        .to(curtain, { yPercent: 0,    duration: 0.45, ease: 'power4.in' })
        .to(curtain, { yPercent: -100, duration: 0.6,  ease: 'power4.out',
          onComplete() {
            preloader.remove();
            document.body.style.overflow = '';
            window.scrollTo(0, 0);
            sessionStorage.setItem('preloader_shown', '1');
            document.dispatchEvent(new CustomEvent('preloader-done'));
          }
        });
    }, 200);
  }

  preloader.addEventListener('click', exitPreloader);
  } // cierre else
</script>
