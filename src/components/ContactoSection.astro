<section id="contacto">
  <span class="section-num" aria-hidden="true">05</span>

  <div class="contacto-inner">

    <p class="sec-eyebrow">
      <span class="eyebrow-dot"></span>
      ¿Hablamos?
    </p>

    <h2 class="contacto-h2" aria-label="HABLAMOS.">
      {"HABLAMOS.".split("").map((c) => (
        <span class="h2-char" aria-hidden="true">{c}</span>
      ))}
    </h2>

    <div class="email-block">
      <p class="email-label">Escríbeme directamente</p>
      <a href="mailto:jose@jotagestudio.es" class="email-link">
        <span class="email-text">jose@jotagestudio.es</span>
        <span class="email-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="contacto-links">
      <div class="links-group">
        <a href="https://linkedin.com/in/jossegonnza" target="_blank" rel="noopener noreferrer" class="link-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>

        <a href="https://github.com/JosseGonnza" target="_blank" rel="noopener noreferrer" class="link-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
          GitHub
        </a>
      </div>

      <span class="links-sep" aria-hidden="true"></span>

      <div class="links-group">
        <a href="/cv" class="link-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
          </svg>
          Ver CV
        </a>

        <a href="/cv-jose-gonzalez.pdf" download class="link-btn link-btn--primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Descargar CV
        </a>
      </div>
    </div>

    <div class="contacto-nota">
      <p class="nota-disponible">Disponible para FCT</p>
      <p class="nota-detalles"><span class="nota-acento">Octubre · 2026</span> · Gijón, Asturias</p>
    </div>

  </div>
</section>

<style>
  #contacto {
    position: relative;
    background: #242424;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(4rem, 8vw, 8rem) clamp(1.5rem, 6vw, 6rem);
    overflow: hidden;
  }

  /* ── Número de fondo ─────────────────────────────────────────── */
  .section-num {
    position: absolute;
    top: 50%;
    right: -0.05em;
    transform: translateY(-50%);
    font-family: 'Syncopate', sans-serif;
    font-weight: 700;
    font-size: clamp(12rem, 28vw, 28rem);
    line-height: 1;
    color: #F3F4F6;
    opacity: 0.025;
    pointer-events: none;
    user-select: none;
  }

  /* ── Inner ───────────────────────────────────────────────────── */
  .contacto-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1100px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ── Eyebrow ─────────────────────────────────────────────────── */
  .sec-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #4B5563;
    margin: 0 0 1.75rem;
  }

  .eyebrow-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #FF5733;
    flex-shrink: 0;
  }

  /* ── Título ──────────────────────────────────────────────────── */
  .contacto-h2 {
    font-family: 'Syncopate', sans-serif;
    font-weight: 700;
    font-size: clamp(2.8rem, 7vw, 7.5rem);
    color: #F3F4F6;
    letter-spacing: -0.03em;
    line-height: 0.9;
    margin: 0 0 clamp(2rem, 4vw, 3.5rem);
    display: flex;
    white-space: nowrap;
  }

  .h2-char {
    display: inline-block;
    white-space: pre;
  }

  /* ── Email ───────────────────────────────────────────────────── */
  .email-block {
    margin-bottom: clamp(3rem, 6vw, 5rem);
    border-left: 2px solid #FF5733;
    padding-left: 1.25rem;
  }

  .email-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4B5563;
    margin: 0 0 0.6rem;
  }

  .email-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: 'Inter', sans-serif;
    font-size: clamp(1.1rem, 2.8vw, 2.4rem);
    font-weight: 300;
    color: #9CA3AF;
    text-decoration: none;
    transition: color 250ms ease;
    width: fit-content;
  }

  .email-link:hover {
    color: #F3F4F6;
  }

  .email-arrow {
    display: inline-block;
    transition: transform 300ms ease;
    color: #FF5733;
  }

  .email-link:hover .email-arrow {
    transform: translateX(10px);
  }

  /* ── Links ───────────────────────────────────────────────────── */
  .contacto-links {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: clamp(3rem, 5vw, 4rem);
  }

  .links-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .links-sep {
    display: block;
    width: 1px;
    height: 28px;
    background: #2E2E2E;
    flex-shrink: 0;
  }

  .link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Syncopate', sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6B7280;
    border: 1px solid #2E2E2E;
    padding: 0.75rem 1.25rem;
    border-radius: 4px;
    text-decoration: none;
    transition: color 200ms ease, border-color 200ms ease, background 200ms ease;
  }

  .link-btn:hover {
    color: #F3F4F6;
    border-color: #4B5563;
  }

  .link-btn--primary {
    color: #FF5733;
    border-color: rgba(255, 87, 51, 0.35);
  }

  .link-btn--primary:hover {
    color: #F3F4F6;
    border-color: #FF5733;
    background: rgba(255, 87, 51, 0.08);
  }

  /* ── Nota ────────────────────────────────────────────────────── */
  .contacto-nota {
    margin: 0;
    border-top: 1px solid #2E2E2E;
    padding-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .nota-disponible {
    font-family: 'Syncopate', sans-serif;
    font-weight: 700;
    font-size: clamp(0.8rem, 1.4vw, 1.1rem);
    color: #F3F4F6;
    letter-spacing: 0.04em;
    margin: 0;
  }

  .nota-detalles {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    color: #6B7280;
    margin: 0;
  }

  .nota-acento {
    color: #FF5733;
  }

  /* ── Mobile ──────────────────────────────────────────────────── */
  @media (max-width: 600px) {
    .contacto-links {
      flex-direction: column;
      align-items: flex-start;
    }

    .links-sep {
      width: 28px;
      height: 1px;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initContacto() {
    const eyebrow = document.querySelector('#contacto .sec-eyebrow') as HTMLElement;
    const chars   = Array.from(document.querySelectorAll<HTMLElement>('#contacto .h2-char'));
    const email   = document.querySelector('.email-block') as HTMLElement;
    const links   = Array.from(document.querySelectorAll<HTMLElement>('.contacto-links .link-btn'));
    const nota    = document.querySelector('.contacto-nota') as HTMLElement;

    gsap.set(eyebrow, { opacity: 0, y: 20 });
    gsap.set(chars,   { opacity: 0, y: 90, rotation: -12 });
    gsap.set(email,   { opacity: 0, x: -20 });
    gsap.set(links,   { opacity: 0, y: 18 });
    gsap.set(nota,    { opacity: 0, y: 12 });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#contacto',
        start: 'top 72%',
        toggleActions: 'play none none none',
      },
    });

    tl.to(eyebrow, { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out' })
      .to(chars,   { opacity: 1, y: 0, rotation: 0, duration: 0.65, stagger: 0.04, ease: 'power3.out' }, '-=0.2')
      .to(email,   { opacity: 1, x: 0, duration: 0.6, ease: 'power3.out' }, '-=0.25')
      .to(links,   { opacity: 1, y: 0, duration: 0.45, stagger: 0.08, ease: 'power2.out' }, '-=0.3')
      .to(nota,    { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, '-=0.1');
  }

  document.addEventListener('preloader-done', initContacto, { once: true });
</script>
