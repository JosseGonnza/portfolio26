---
const hitos = [
  {
    fecha: '2014 – 2026',
    lado: 'right',
    tag: 'Experiencia',
    titulo: 'Sector HORECA',
    subtitulo: 'Cocinero · Jefe de Partida',
    desc: 'Más de 10 años liderando equipos en cocinas de alta demanda en Tenerife, Cantabria y Asturias. La disciplina y el trabajo bajo presión son parte de cómo funciono.',
    destacado: false,
  },
  {
    fecha: '2018 – 2020',
    lado: 'left',
    tag: 'Formación',
    titulo: 'CFGS Dirección de Cocina',
    subtitulo: 'Grado Superior · Gastronomía',
    desc: 'Formación técnica en gestión de cocina, organización de equipos y procesos de producción en entornos de alta exigencia.',
    destacado: false,
  },
  {
    fecha: '2024',
    lado: 'right',
    tag: 'Certificación',
    titulo: 'IBM SkillsBuild',
    subtitulo: 'Desarrollo Web en Python',
    desc: 'Primer paso deliberado hacia el desarrollo. La primera vez que escribir código dejó de ser algo ajeno.',
    destacado: false,
  },
  {
    fecha: '2025 – hoy',
    lado: 'left',
    tag: 'Formación',
    titulo: 'CFGS DAW',
    subtitulo: 'IES Alcazarén · A distancia',
    desc: 'Desarrollo de Aplicaciones Web. Java, Spring Boot, SQL, Docker, TDD. La base técnica formal que complementa lo aprendido en producción.',
    destacado: false,
  },
  {
    fecha: '2026',
    lado: 'right',
    tag: 'Producción',
    titulo: 'JotaGe Studio',
    subtitulo: 'Fundador · Desarrollo Web',
    desc: 'Primeros clientes reales en producción. Webs para hostelería con Astro, Tailwind y Cloudflare. PageSpeed 90–100. La prueba de que se puede entregar.',
    destacado: false,
  },
  {
    fecha: 'Oct · 2026',
    lado: 'left',
    tag: 'Próximo',
    titulo: 'FCT — Disponible',
    subtitulo: 'Buscando equipo',
    desc: 'Prácticas en empresa. Busco un equipo donde el código se cuide y haya margen para aprender haciendo.',
    destacado: true,
  },
] as { fecha: string; lado: 'left' | 'right'; tag: string; titulo: string; subtitulo: string; desc: string; destacado: boolean }[];
---

<section id="trayectoria">
  <span class="section-num" aria-hidden="true">04</span>

  <div class="tray-inner">
    <div class="tray-header">
      <p class="sec-eyebrow">
        <span class="eyebrow-dot"></span>
        El recorrido
      </p>
      <h2 class="tray-h2">
        <span class="h2-line1">Trayectoria</span>
        <span class="h2-line2">de dónde vengo.</span>
      </h2>
    </div>

    <div class="timeline">
      <div class="tl-axis">
        <div class="tl-axis-fill"></div>
      </div>

      {hitos.map((hito) => (
        <div class={`tl-item tl-${hito.lado}${hito.destacado ? ' tl-destacado' : ''}`}>
          {hito.lado === 'left' ? (
            <>
              <div class="tl-content">
                <span class="tl-tag">{hito.tag}</span>
                <p class="tl-fecha">{hito.fecha}</p>
                <h3 class="tl-titulo">{hito.titulo}</h3>
                <p class="tl-subtitulo">{hito.subtitulo}</p>
                <p class="tl-desc">{hito.desc}</p>
              </div>
              <div class="tl-node">
                <div class="tl-line-h"></div>
                <div class="tl-dot"></div>
              </div>
              <div class="tl-spacer"></div>
            </>
          ) : (
            <>
              <div class="tl-spacer"></div>
              <div class="tl-node">
                <div class="tl-line-h"></div>
                <div class="tl-dot"></div>
              </div>
              <div class="tl-content">
                <span class="tl-tag">{hito.tag}</span>
                <p class="tl-fecha">{hito.fecha}</p>
                <h3 class="tl-titulo">{hito.titulo}</h3>
                <p class="tl-subtitulo">{hito.subtitulo}</p>
                <p class="tl-desc">{hito.desc}</p>
              </div>
            </>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  #trayectoria {
    position: relative;
    background: #1A1A1A;
    padding: clamp(5rem, 10vw, 9rem) clamp(1.5rem, 6vw, 6rem);
    overflow: hidden;
  }

  /* ── Número de fondo ─────────────────────────────────────────── */
  .section-num {
    position: absolute;
    top: 50%;
    right: -0.05em;
    transform: translateY(-50%);
    font-family: 'Syncopate', sans-serif;
    font-weight: 700;
    font-size: clamp(12rem, 28vw, 28rem);
    line-height: 1;
    color: #F3F4F6;
    opacity: 0.025;
    pointer-events: none;
    user-select: none;
  }

  /* ── Inner ───────────────────────────────────────────────────── */
  .tray-inner {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
  }

  /* ── Cabecera ────────────────────────────────────────────────── */
  .tray-header {
    margin-bottom: clamp(4rem, 8vw, 7rem);
  }

  .sec-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #4B5563;
    margin: 0 0 1.25rem;
  }

  .eyebrow-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #FF5733;
  }

  .tray-h2 {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    margin: 0;
    line-height: 0.9;
  }

  .h2-line1 {
    font-family: 'Syncopate', sans-serif;
    font-weight: 700;
    font-size: clamp(2.2rem, 5.5vw, 6rem);
    color: #F3F4F6;
    letter-spacing: -0.02em;
    display: block;
  }

  .h2-line2 {
    font-family: 'Syncopate', sans-serif;
    font-weight: 700;
    font-size: clamp(1.1rem, 2.8vw, 3rem);
    color: #6B7280;
    letter-spacing: -0.01em;
    display: block;
  }

  /* ── Timeline ────────────────────────────────────────────────── */
  .timeline {
    position: relative;
  }

  /* Eje vertical central */
  .tl-axis {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    transform: translateX(-50%);
    background: #2E2E2E;
    z-index: 0;
  }

  .tl-axis-fill {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #FF5733;
    transform-origin: top;
    transform: scaleY(0);
  }

  /* ── Hito ────────────────────────────────────────────────────── */
  .tl-item {
    display: grid;
    grid-template-columns: 1fr 88px 1fr;
    align-items: start;
    padding: 2.5rem 0;
    position: relative;
    z-index: 1;
    cursor: default;
    will-change: opacity, transform;
  }

  /* Nodo central */
  .tl-node {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding-top: 0.85rem;
  }

  .tl-line-h {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    height: 1px;
    background: #2E2E2E;
    width: 100%;
    z-index: 0;
  }

  .tl-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 2px solid #2E2E2E;
    background: #1A1A1A;
    position: relative;
    z-index: 2;
    flex-shrink: 0;
    will-change: transform;
  }

  .tl-item:hover .tl-node {
    z-index: 10;
  }

  /* Último hito — destacado */
  .tl-destacado .tl-dot {
    border-color: #FF5733;
    box-shadow: 0 0 0 4px rgba(255, 87, 51, 0.15);
  }

  .tl-destacado .tl-tag {
    color: #FF5733;
    border-color: rgba(255, 87, 51, 0.3);
  }

  /* ── Contenido ───────────────────────────────────────────────── */
  .tl-content {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .tl-left .tl-content {
    text-align: right;
    padding-right: 2rem;
    align-items: flex-end;
  }

  .tl-right .tl-content {
    text-align: left;
    padding-left: 2rem;
    align-items: flex-start;
  }

  .tl-spacer { /* col vacía */ }

  .tl-tag {
    font-family: 'Syncopate', sans-serif;
    font-size: 0.48rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #4B5563;
    border: 1px solid #2E2E2E;
    padding: 3px 8px;
    border-radius: 3px;
    width: fit-content;
    margin-bottom: 0.4rem;
  }

  .tl-fecha {
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    color: #4B5563;
    letter-spacing: 0.04em;
    margin: 0;
  }

  .tl-titulo {
    font-family: 'Syncopate', sans-serif;
    font-weight: 700;
    font-size: clamp(0.85rem, 1.4vw, 1.1rem);
    color: #F3F4F6;
    letter-spacing: -0.01em;
    margin: 0.1rem 0 0;
    line-height: 1.2;
  }

  .tl-subtitulo {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: #6B7280;
    margin: 0;
  }

  .tl-desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
    color: #4B5563;
    line-height: 1.65;
    margin: 0.6rem 0 0;
    max-width: 38ch;
  }

  /* ── Mobile ──────────────────────────────────────────────────── */
  @media (max-width: 700px) {
    .tl-item {
      grid-template-columns: 32px 1fr;
      grid-template-rows: auto;
    }

    .tl-item.tl-left,
    .tl-item.tl-right {
      grid-template-columns: 32px 1fr;
    }

    .tl-spacer { display: none; }

    .tl-node {
      grid-column: 1;
      grid-row: 1;
    }

    .tl-content {
      grid-column: 2;
      grid-row: 1;
      text-align: left !important;
      align-items: flex-start !important;
      padding-left: 1.5rem !important;
      padding-right: 0 !important;
    }

    .tl-axis {
      left: 15px;
    }

    .tl-line-h {
      display: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initTrayectoria() {
    const header   = document.querySelector('.tray-header') as HTMLElement;
    const axisfill = document.querySelector('.tl-axis-fill') as HTMLElement;
    const items    = Array.from(document.querySelectorAll<HTMLElement>('.tl-item'));

    // ── Header ───────────────────────────────────────────────────
    gsap.set(header, { opacity: 0, y: 30 });
    gsap.to(header, {
      opacity: 1, y: 0, duration: 1.1, ease: 'expo.out',
      scrollTrigger: { trigger: '#trayectoria', start: 'top 78%', toggleActions: 'play none none none' },
    });

    // ── Línea que se dibuja hacia abajo ──────────────────────────
    gsap.to(axisfill, {
      scaleY: 1,
      ease: 'none',
      scrollTrigger: {
        trigger: '.timeline',
        start: 'top 55%',
        end: 'bottom 65%',
        scrub: 1.4,
      },
    });

    // ── Hitos — entran desde su lado ────────────────────────────
    items.forEach((item) => {
      const isLeft  = item.classList.contains('tl-left');
      const content = item.querySelector<HTMLElement>('.tl-content')!;
      const dot     = item.querySelector<HTMLElement>('.tl-dot')!;

      gsap.set(content, { opacity: 0, x: isLeft ? -38 : 38 });
      gsap.set(dot, { scale: 0, opacity: 0 });

      const entryTl = gsap.timeline({
        scrollTrigger: { trigger: item, start: 'top 82%', toggleActions: 'play none none none' },
      });
      entryTl
        .to(dot,     { scale: 1, opacity: 1, duration: 0.5, ease: 'back.out(1.4)' })
        .to(content, { opacity: 1, x: 0, duration: 0.85, ease: 'expo.out' }, '-=0.25');
    });

    // ── Hover: el dot rompe la barra y el item hace zoom ─────────
    const DOT_SCALE    = 5;
    const DIM_OPACITY  = 0.18;
    const CONTENT_SCALE = 1.05;

    items.forEach((item, i) => {
      const dot     = item.querySelector<HTMLElement>('.tl-dot')!;
      const content = item.querySelector<HTMLElement>('.tl-content')!;
      const lineH   = item.querySelector<HTMLElement>('.tl-line-h')!;
      const others  = items.filter((_, j) => j !== i);

      item.addEventListener('mouseenter', () => {
        // El dot crece y tapa la línea → efecto rotura
        gsap.to(dot, {
          scale: DOT_SCALE,
          borderColor: '#FF5733',
          backgroundColor: '#1A1A1A',
          boxShadow: '0 0 0 2px rgba(255,87,51,0.25)',
          duration: 0.4,
          ease: 'power3.out',
          overwrite: 'auto',
        });
        // La línea horizontal desaparece (el dot ya la tapa)
        gsap.to(lineH, { opacity: 0, duration: 0.2, overwrite: 'auto' });
        // El contenido hace zoom
        gsap.to(content, {
          scale: CONTENT_SCALE,
          duration: 0.4,
          ease: 'power3.out',
          overwrite: 'auto',
        });
        // Los demás se oscurecen y encogen levemente
        others.forEach(other => {
          gsap.to(other, { opacity: DIM_OPACITY, scale: 0.97, duration: 0.35, overwrite: 'auto' });
        });
      });

      item.addEventListener('mouseleave', () => {
        gsap.to(dot, {
          scale: 1,
          borderColor: item.classList.contains('tl-destacado') ? '#FF5733' : '#2E2E2E',
          backgroundColor: '#1A1A1A',
          boxShadow: 'none',
          duration: 0.35,
          ease: 'power2.out',
          overwrite: 'auto',
        });
        gsap.to(lineH, { opacity: 1, duration: 0.25, overwrite: 'auto' });
        gsap.to(content, { scale: 1, duration: 0.35, ease: 'power2.out', overwrite: 'auto' });
        others.forEach(other => {
          gsap.to(other, { opacity: 1, scale: 1, duration: 0.35, overwrite: 'auto' });
        });
      });
    });
  }

  document.addEventListener('preloader-done', initTrayectoria, { once: true });
</script>
