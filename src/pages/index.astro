---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="min-h-screen flex items-center justify-center px-6">
    <div class="text-center">
      <p style="font-family:'Syncopate',sans-serif; font-size:0.65rem; letter-spacing:0.22em; color:#FF5733; text-transform:uppercase; margin-bottom:2rem;">
        En construcción
      </p>
      <h1 style="font-family:'Syncopate',sans-serif; font-size:clamp(2rem,6vw,5rem); font-weight:700; color:#F3F4F6; line-height:0.95; letter-spacing:-0.03em;">
        Jose González
      </h1>
      <p style="font-family:'Inter',sans-serif; font-size:1rem; color:#6B7280; margin-top:1.5rem;">
        Backend developer · Próximamente
      </p>
      <div style="margin-top:2.5rem; display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
        <a href="https://jotagestudio.es" class="btn-ghost">jotagestudio.es ↗</a>
        <a href="https://github.com/JosseGonnza" class="btn-ghost">GitHub ↗</a>
      </div>
    </div>
  </main>
</Layout>
