---
import Layout from '../layouts/Layout.astro';
import Preloader from '../components/Preloader.astro';
import HeroPortfolio from '../components/HeroPortfolio.astro';
import StackSection from '../components/StackSection.astro';
import ProyectosSection from '../components/ProyectosSection.astro';
import TrayectoriaSection from '../components/TrayectoriaSection.astro';
import ContactoSection from '../components/ContactoSection.astro';
---

<Layout>
  <Preloader />
  <main>
    <HeroPortfolio />

    <div id="h-scene">
      <div id="h-scene-track">
        <StackSection />
        <ProyectosSection />
      </div>
    </div>
    <TrayectoriaSection />
    <ContactoSection />
  </main>

  <!-- Modal — fuera de #h-scene para no heredar su transform -->
  <div id="card-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modal-titulo">
    <div class="modal-backdrop"></div>
    <div class="modal-panel">
      <button class="modal-close" id="modal-close-btn" aria-label="Cerrar">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M3 3L15 15M15 3L3 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>

      <div class="modal-meta">
        <span class="modal-tipo" id="modal-tipo"></span>
        <span class="modal-estado" id="modal-estado"></span>
      </div>

      <h2 class="modal-titulo" id="modal-titulo"></h2>
      <p class="modal-subtitulo" id="modal-subtitulo"></p>
      <p class="modal-desc" id="modal-desc"></p>

      <div class="modal-stack" id="modal-stack"></div>
      <div class="modal-ctas" id="modal-ctas"></div>
    </div>
  </div>
</Layout>

<style>
  /* ── Escena horizontal ───────────────────────────────────────── */
  #h-scene {
    position: relative;
    overflow: hidden;
  }

  #h-scene-track {
    display: flex;
    align-items: stretch;
    height: 100dvh;
  }

  /* ── Modal ───────────────────────────────────────────────────── */
  #card-modal {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    pointer-events: none;
    opacity: 0;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(8, 8, 8, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .modal-panel {
    position: relative;
    z-index: 1;
    background: #1C1C1C;
    border: 1px solid #2E2E2E;
    border-radius: 8px;
    padding: clamp(1.75rem, 4vw, 3rem);
    width: min(92vw, 640px);
    max-height: 88dvh;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #2E2E2E transparent;
    box-shadow:
      0 40px 100px rgba(0, 0, 0, 0.7),
      0 0 0 1px rgba(255, 255, 255, 0.04),
      0 30px 60px rgba(255, 87, 51, 0.08);
  }

  .modal-close {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid #2E2E2E;
    border-radius: 50%;
    background: transparent;
    color: #6B7280;
    cursor: pointer;
    transition: color 200ms ease, border-color 200ms ease, background 200ms ease;
    flex-shrink: 0;
  }

  .modal-close:hover {
    color: #F3F4F6;
    border-color: #4B5563;
    background: #242424;
  }

  .modal-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-right: 2.5rem;
  }

  .modal-tipo {
    font-family: 'Syncopate', sans-serif;
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #4B5563;
  }

  .modal-estado {
    font-family: 'Syncopate', sans-serif;
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .modal-titulo {
    font-family: 'Syncopate', sans-serif;
    font-weight: 700;
    font-size: clamp(1.6rem, 4vw, 2.8rem);
    color: #F3F4F6;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 0 0 0.5rem;
  }

  .modal-subtitulo {
    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
    color: #6B7280;
    margin: 0 0 1.5rem;
  }

  .modal-desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.98rem;
    color: #9CA3AF;
    line-height: 1.8;
    margin: 0 0 1.75rem;
    border-top: 1px solid #2E2E2E;
    padding-top: 1.5rem;
  }

  .modal-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.75rem;
  }

  .modal-chip {
    font-family: 'Syncopate', sans-serif;
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6B7280;
    border: 1px solid #2E2E2E;
    padding: 5px 10px;
    border-radius: 4px;
  }

  .modal-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    border-top: 1px solid #2E2E2E;
    padding-top: 1.5rem;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('preloader-done', () => {
    const track = document.getElementById('h-scene-track') as HTMLElement;
    const cards = Array.from(track.querySelectorAll<HTMLElement>('.proyecto-card'));

    // GSAP gestiona los transforms desde el inicio
    cards.forEach(card => {
      gsap.set(card, { rotation: parseFloat(card.dataset.rotation ?? '0'), scale: 1, x: 0 });
    });

    // ── Hover ────────────────────────────────────────────────────
    const SCALE = 1.22;
    const PUSH  = 48;

    cards.forEach((card, i) => {
      const base = parseFloat(card.dataset.rotation ?? '0');

      card.addEventListener('mouseenter', () => {
        cards.forEach((c, j) => {
          const b = parseFloat(c.dataset.rotation ?? '0');
          if (j === i) {
            gsap.to(c, { scale: SCALE, rotation: base * 0.25, duration: 0.35, ease: 'power2.out', overwrite: 'auto' });
          } else if (j === i - 1) {
            gsap.to(c, { x: -PUSH, duration: 0.35, ease: 'power2.out', overwrite: 'auto' });
          } else if (j === i + 1) {
            gsap.to(c, { x:  PUSH, duration: 0.35, ease: 'power2.out', overwrite: 'auto' });
          } else {
            gsap.to(c, { x: 0, duration: 0.25, ease: 'power2.out', overwrite: 'auto' });
          }
        });
      });

      card.addEventListener('mouseleave', () => {
        cards.forEach(c => {
          const b = parseFloat(c.dataset.rotation ?? '0');
          gsap.to(c, { scale: 1, rotation: b, x: 0, duration: 0.35, ease: 'power2.out', overwrite: 'auto' });
        });
      });
    });

    // ── ScrollTrigger horizontal ─────────────────────────────────
    gsap.to(track, {
      x: () => -(track.scrollWidth - window.innerWidth),
      ease: 'none',
      scrollTrigger: {
        trigger: '#h-scene',
        pin: true,
        scrub: 0.85,
        start: 'top top',
        end: () => `+=${track.scrollWidth - window.innerWidth}`,
        invalidateOnRefresh: true,
      },
    });

    // ── Modal ────────────────────────────────────────────────────
    const modal   = document.getElementById('card-modal')    as HTMLElement;
    const mPanel  = modal.querySelector('.modal-panel')       as HTMLElement;
    const mClose  = document.getElementById('modal-close-btn') as HTMLButtonElement;
    const mTipo   = document.getElementById('modal-tipo')    as HTMLElement;
    const mEstado = document.getElementById('modal-estado')  as HTMLElement;
    const mTitulo = document.getElementById('modal-titulo')  as HTMLElement;
    const mSub    = document.getElementById('modal-subtitulo') as HTMLElement;
    const mDesc   = document.getElementById('modal-desc')    as HTMLElement;
    const mStack  = document.getElementById('modal-stack')   as HTMLElement;
    const mCtas   = document.getElementById('modal-ctas')    as HTMLElement;

    let lastFocused: HTMLElement | null = null;

    function openModal(card: HTMLElement) {
      lastFocused = card;

      // Poblar contenido
      mTipo.textContent   = card.dataset.tipo ?? '';
      mEstado.textContent = card.dataset.estado ?? '';
      mEstado.style.color = card.dataset.estadoColor ?? '#6B7280';
      mTitulo.textContent = card.dataset.titulo ?? '';
      mSub.textContent    = card.dataset.subtitulo ?? '';
      mDesc.textContent   = card.dataset.desc ?? '';

      mStack.innerHTML = '';
      (JSON.parse(card.dataset.stack ?? '[]') as string[]).forEach(t => {
        const s = document.createElement('span');
        s.className   = 'modal-chip';
        s.textContent = t;
        mStack.appendChild(s);
      });

      mCtas.innerHTML = '';
      (JSON.parse(card.dataset.ctas ?? '[]') as {label:string;href:string;primary:boolean}[]).forEach(cta => {
        const a = document.createElement('a');
        a.href      = cta.href;
        a.target    = '_blank';
        a.rel       = 'noopener noreferrer';
        a.textContent = cta.label;
        a.className = cta.primary ? 'btn-primary' : 'btn-ghost';
        mCtas.appendChild(a);
      });

      // Mostrar
      modal.setAttribute('aria-hidden', 'false');
      modal.style.pointerEvents = 'all';
      document.body.style.overflow = 'hidden';

      gsap.fromTo(modal,  { opacity: 0 },            { opacity: 1, duration: 0.25, ease: 'power2.out' });
      gsap.fromTo(mPanel, { scale: 0.94, y: 24 },    { scale: 1, y: 0, duration: 0.38, ease: 'power3.out' });

      setTimeout(() => mClose.focus(), 40);
    }

    function closeModal() {
      gsap.to(modal, {
        opacity: 0,
        duration: 0.2,
        ease: 'power2.in',
        onComplete() {
          modal.setAttribute('aria-hidden', 'true');
          modal.style.pointerEvents = 'none';
          document.body.style.overflow = '';
          lastFocused?.focus();
        },
      });
      gsap.to(mPanel, { scale: 0.96, y: 12, duration: 0.2, ease: 'power2.in' });
    }

    mClose.addEventListener('click', closeModal);
    modal.querySelector('.modal-backdrop')!.addEventListener('click', closeModal);
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && modal.getAttribute('aria-hidden') === 'false') closeModal();
    });

    // Click + teclado en cards
    cards.forEach(card => {
      card.addEventListener('click', () => openModal(card));
      card.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openModal(card); }
      });
    });
  }, { once: true });
</script>
